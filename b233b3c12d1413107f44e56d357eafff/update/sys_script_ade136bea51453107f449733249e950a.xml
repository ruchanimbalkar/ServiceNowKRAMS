        <script><![CDATA[(function executeRule(current, previous) {

    // Read the policy numbers from System Properties (no hardcoding)
    var windowDays = parseInt(gs.getProperty('x_1234_parking_c_0.appeal.window', '14'), 10);
    var remindBefore = parseInt(gs.getProperty('x_1234_parking_c_0.appeal.reminddays', '3'), 10);

    // Start from the date the citation was issued
    var deadline = new GlideDateTime(current.getValue('issued_on'));
    deadline.addDaysLocalTime(windowDays);

    var reminder = new GlideDateTime(current.getValue('issued_on'));
    reminder.addDaysLocalTime(windowDays - remindBefore);

    // Save only the date part (both fields are Date fields)
    current.setValue('appeal_deadline', deadline.getLocalDate().getValue());
    current.setValue('appel_reminder_date', reminder.getLocalDate().getValue());

})(current, previous);]]></script>
